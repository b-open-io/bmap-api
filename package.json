{
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@napi-rs/canvas": "^0.1.100",
    "bmapjs": "0.4.0",
    "bpu-ts": "^0.0.26",
    "chalk": "^5.6.2",
    "chart.js": "^4.5.1",
    "elysia": "^1.4.30",
    "lodash": "^4.18.1",
    "mongodb": "^6.21.0",
    "quickchart-js": "^3.1.3",
    "redis": "^4.7.1",
    "typescript": "^5.9.3",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "^1.4.2",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.3",
    "openapi-types": "^12.1.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:unsafe": "biome check --write --unsafe .",
    "test-redis": "bun scripts/test-redis.ts",
    "prepare-hooks": "cp git-hooks/* .git/hooks/ && chmod +x .git/hooks/*",
    "migrate:b-data": "bun run scripts/migrate-b-data-to-content.ts",
    "build:types": "bun scripts/publish-types.ts",
    "publish:types": "bun scripts/publish-types.ts --publish",
    "publish:types:dry": "bun scripts/publish-types.ts --publish --dry-run"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
